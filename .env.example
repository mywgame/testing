# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# MetaFirm Platform - Environment Configuration Blueprint
# =========================================================================

# General Application Port & Host
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"
# Optional API Base URL override for client apps (e.g., Capacitor Android/iOS builds)
VITE_API_BASE_URL=""

# JWT Authentication Configuration
JWT_SECRET="super-secret-key-change-in-production-cefi"
JWT_REFRESH_SECRET="super-refresh-secret-key-change-in-production-cefi"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Relational Database URL (Relational fallback connection string if requested)
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# Cloud SQL Integration Variables (Rely on these for the Object Method connection pooling)
# Automatically provided in the Cloud Run runtime, or populated locally during testing.
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="ai-studio"
SQL_USER="sql_app_user"
SQL_PASSWORD="secure_app_password"

# Schema Management Admin Credentials (Used by Drizzle Kit for database migrations)
SQL_ADMIN_USER="sql_admin_user"
SQL_ADMIN_PASSWORD="secure_admin_password"

# Superadmin Bootstrap Credentials
SUPERADMIN_EMAIL="superadmin@cefi.platform"
SUPERADMIN_PASSWORD="SecureSuperPass123!"

# Email Service Configuration (Resend) — REQUIRED, no defaults.
# EmailService/ResendProvider fail fast at construction time if either is missing.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MetaFirm <noreply@metafirm.app>"

# =========================================================================
# Self-Managed HD Wallet & Blockchain Configurations
# =========================================================================
# Blockchain Provider: 'rpc' (Direct Native Blockchain Node RPC)
BLOCKCHAIN_PROVIDER="rpc"

# Master Seed Mnemonic phrase for deterministic HD wallet derivation across all chains
MASTER_SEED_MNEMONIC="twelve word secret mnemonic phrase goes here for hd derivation"

# RPC Endpoint Custom Overrides (Optional; high-availability public fallbacks are built-in)
BSC_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545"
BSC_RPC_URL_FALLBACK="https://bsc-testnet.publicnode.com"

POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
POLYGON_RPC_URL_FALLBACK="https://polygon-amoy.drpc.org"

TRON_RPC_URL="https://nile.trongrid.io"
TRON_RPC_URL_FALLBACK="https://api.shasta.trongrid.io"

# Environment mode: 'production', 'sandbox', or 'development' (default: 'development')
BLOCKCHAIN_ENV="sandbox"

# Optional explicit testnet flag override ('true' or 'false')
IS_TESTNET="true"

# Custom Token Contract Overrides (Optional; defaults automatically selected based on environment)
USDT_BEP20_CONTRACT=""
USDT_POLYGON_CONTRACT=""
USDT_TRC20_CONTRACT=""

